# Nandha Music — environment config (copy to .env, never commit real keys)
# Supabase free project (Auth + Postgres + Storage for covers/metadata)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare R2 public base URL for audio files (10 GB free, zero egress)
# Example: https://pub-xxxxxxxx.r2.dev
VITE_AUDIO_BASE_URL=
# Upstash Redis free (server cache: home feed, search, play counts)
VITE_UPSTASH_REDIS_REST_URL=
VITE_UPSTASH_REDIS_REST_TOKEN=
# Demo mode (26 Nov 2026, OpenCodeReview M2): ONLY VITE_DEMO_MODE=true
# enables demo mode. Missing Supabase keys alone do NOT enable it —
# without Supabase and without this flag, sign-in is unavailable
# (configuration error). In demo mode every sign-in is a listener;
# admin is never granted.
VITE_DEMO_MODE=false
