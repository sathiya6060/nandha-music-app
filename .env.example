# Nandha Music — environment config (copy to .env, never commit real keys)
# Supabase free project (Auth + Postgres + Storage for covers/metadata)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare R2 public base URL for audio files — NOT USED (27 Nov 2026):
# the R2 account needs a card, which is blocked, so no R2 bucket exists.
# Audio is delivered as signed Supabase Storage URLs (see
# src/lib/signedAudio.js). Leave VITE_AUDIO_BASE_URL unset; the variable
# is kept only so the optional R2 fallback in src/lib/config.js still
# works if R2 is ever configured.
VITE_AUDIO_BASE_URL=
# Upstash Redis free (server cache: home feed, play counts — search is
# deliberately NOT wired through Redis; unique queries would burn the
# budget, see src/pages/Home.jsx)
# Free tier: 500K commands/month, 256 MB, 10 GB bandwidth, no card.
# BROWSER TOKEN MUST BE READ-ONLY (Upstash console -> Redis -> REST API
# -> read-only token). NEVER put the full-access token here — it lives
# ONLY in the redis-cache Edge Function env (Supabase dashboard).
# Monthly budget guard: src/lib/redisGuard.js, default 450,000 (90%).
VITE_UPSTASH_REDIS_REST_URL=
VITE_UPSTASH_REDIS_REST_TOKEN=
VITE_REDIS_MONTHLY_BUDGET=450000
# Demo mode (26 Nov 2026, OpenCodeReview M2): ONLY VITE_DEMO_MODE=true
# enables demo mode. Missing Supabase keys alone do NOT enable it —
# without Supabase and without this flag, sign-in is unavailable
# (configuration error). In demo mode every sign-in is a listener;
# admin is never granted.
VITE_DEMO_MODE=false
