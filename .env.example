# Nandha Music — environment config (copy to .env, never commit real keys)
# Supabase free project (Auth + Postgres + Storage for covers/metadata)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare R2 public base URL for audio files (10 GB free, zero egress)
# Example: https://pub-xxxxxxxx.r2.dev
VITE_AUDIO_BASE_URL=
# Upstash Redis free (server cache: home feed, search, play counts)
VITE_UPSTASH_REDIS_REST_URL=
VITE_UPSTASH_REDIS_REST_TOKEN=
# When Supabase keys are empty the app runs in DEMO MODE:
# real track + 199 clearly-marked sample tracks, localStorage-backed likes/playlists/admin.
