# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment secrets (S8, 27 Nov 2026): the real .env holds live
# Supabase keys — it must never be committed, even by accident
# (one careless `git add .` in this dir would leak them).
.env*
!.env.example

# Keys / certificates / credentials (A1-1, 28 Nov 2026): a stray key
# file dropped in the tree must never be committable by `git add .`.
*.pem
*.key
*.pfx
id_rsa*
credentials*
*secret*

# Build artifacts mutated by `prebuild` (A1-2): version.json holds only
# buildId + builtAt, but it changes on every build and must never be
# committed. The bare pattern matches at any depth (src + public).
version.json
